class MatchMode(Enum):
    """The match mode for graph matcher

    StrictMode: the pattern must strictly match, all internal edges must be same as pattern.

    RelaxedMode: the graph is match the pattern, but with more internal edges. for example:
                 pattern= n0->n1, n1->n2
                 graph= n0->n1,n1->n2,n0->n2 this graph can match the pattern

    WithAnyMode: the NoOp would regards as a Any type of op, it is a wildcard type.

    GreedyMode: it would regardless the overlay between two matches, for example:
             pattern = Type0->Type1
             graph = n0(Type0)->n1(Type1), n0->n2(Type1), n3(Type0)->n1
         in this case, we will give tree matched: n0->n1, n0->n2, n3->n1.
         if not in greedy mode, the return: n0->n1 or (n0->n2,n3->n1), none of viewed node can be do second match.

    """
    StrictMode = ...
    RelaxedMode = ...
    WithAnyMode = ...
    GreedyMode = ...


class GraphMatcher(object):
    '''!
    A Graph matcher for matching a pattern in a graph


    Attributes:
        mode    The MatchMode of the matcher
    '''

    mode: MatchMode

    def __init__(self, nodes: list, edges: list) -> None:
        """!Initialize the GraphMatcher by nodes and edges

        Args:
            nodes(list): a list of node which is defined by a tuple of  (str,OpType),
                        for example ("node0",OpType.Input) defines a input node named "node0"
            edges(list): a list of edge which is defined by a tuple of (str,str),
                        str is a node's name defined in nodes, for example ("node0","node1") defines an edge node0->node1
        """
        ...

    def match(self, graph: Graph) -> NodeList:
        """!match a graph

        Args:
            graph(Graph): a graph to be matched
        Returns:
            a list of NodeList: each NodeList is a matched case.
        """


