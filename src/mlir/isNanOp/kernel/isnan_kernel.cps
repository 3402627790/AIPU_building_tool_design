#include "isnan_kernel.h"

DECLARE_DEVICE_VARIANT(ISNAN_KERNEL_BASE_NAME)
{
    grid_stride_contiguous_loop(n, [&](int idx) { dst[idx] = (src[idx] != src[idx]) ? 1 : 0; });
}

INSTANTIATE_KERNEL(ISNAN_KERNEL_BASE_NAME, float32, int8)
INSTANTIATE_KERNEL(ISNAN_KERNEL_BASE_NAME, float32, int16)
INSTANTIATE_KERNEL(ISNAN_KERNEL_BASE_NAME, float32, int32)
INSTANTIATE_KERNEL(ISNAN_KERNEL_BASE_NAME, float16, int8)
INSTANTIATE_KERNEL(ISNAN_KERNEL_BASE_NAME, float16, int16)
INSTANTIATE_KERNEL(ISNAN_KERNEL_BASE_NAME, float16, int32)
INSTANTIATE_KERNEL(ISNAN_KERNEL_BASE_NAME, bfloat16, int8)
INSTANTIATE_KERNEL(ISNAN_KERNEL_BASE_NAME, bfloat16, int16)
INSTANTIATE_KERNEL(ISNAN_KERNEL_BASE_NAME, bfloat16, int32)

