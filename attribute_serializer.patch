+    // ===== 序列化 Node Attributes (新增代码) =====
+    if (BuilderConfig::get<bool>(Constants::dump_debug_IR))
+    {
+        // 定义不应该序列化的 attributes（运行时绑定或指针类型）
+        static const std::set<std::string> skip_attrs = {
+            Constants::plugin_impl,        // GOP plugin 运行时绑定
+            Constants::kernel_infos,       // 运行时信息
+            "graph",                       // graph 指针
+            "subgraph",                    // subgraph 指针
+            "parent_graph",                // 父 graph 指针
+            "codetree",                    // 代码树指针
+        };
+
+        utils::JsonObject attrs_json(utils::JsonObject::OBJ);
+        bool has_attrs = false;
+
+        for (const auto& attr : m_attrs)
+        {
+            // 跳过不可序列化的 attributes
+            if (skip_attrs.count(attr.first))
+                continue;
+
+            const auto& key = attr.first;
+            const auto& value = attr.second;
+
+            // 根据类型转换为 JSON
+            try
+            {
+                if (value.is<int>())
+                {
+                    attrs_json[key] = value.cast<int>();
+                    has_attrs = true;
+                }
+                else if (value.is<int64_t>())
+                {
+                    attrs_json[key] = value.cast<int64_t>();
+                    has_attrs = true;
+                }
+                else if (value.is<uint32_t>())
+                {
+                    attrs_json[key] = (int64_t)value.cast<uint32_t>();
+                    has_attrs = true;
+                }
+                else if (value.is<uint64_t>())
+                {
+                    attrs_json[key] = (int64_t)value.cast<uint64_t>();
+                    has_attrs = true;
+                }
+                else if (value.is<float>())
+                {
+                    attrs_json[key] = value.cast<float>();
+                    has_attrs = true;
+                }
+                else if (value.is<double>())
+                {
+                    attrs_json[key] = value.cast<double>();
+                    has_attrs = true;
+                }
+                else if (value.is<bool>())
+                {
+                    attrs_json[key] = value.cast<bool>();
+                    has_attrs = true;
+                }
+                else if (value.is<std::string>())
+                {
+                    attrs_json[key] = value.cast<std::string>();
+                    has_attrs = true;
+                }
+                else if (value.is<std::vector<int>>())
+                {
+                    auto vec = value.cast<std::vector<int>>();
+                    utils::JsonObject arr(utils::JsonObject::ARR);
+                    for (int v : vec)
+                        arr.push_back(v);
+                    attrs_json[key] = arr;
+                    has_attrs = true;
+                }
+                else if (value.is<std::vector<float>>())
+                {
+                    auto vec = value.cast<std::vector<float>>();
+                    utils::JsonObject arr(utils::JsonObject::ARR);
+                    for (float v : vec)
+                        arr.push_back(v);
+                    attrs_json[key] = arr;
+                    has_attrs = true;
+                }
+                else
+                {
+                    // 不支持的类型，跳过
+                    DEBUG() << "Cannot serialize attribute '" << key
+                            << "' for node '" << m_name << "': unsupported type";
+                }
+            }
+            catch (...)
+            {
+                DEBUG() << "Exception while serializing attribute '" << key
+                        << "' for node '" << m_name << "'";
+            }
+        }
+
+        // 输出 JSON 字符串
+        if (has_attrs)
+        {
+            oss << "node_attrs=" << attrs_json.to_string() << "\n";
+        }
+    }

